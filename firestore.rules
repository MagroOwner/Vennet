rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userRole() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && userRole() == 'admin';
    }

    function isModerator() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && (userRole() == 'admin' || userRole() == 'moderator');
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['email', 'createdAt'])
        && !('isPro' in request.resource.data)
        && !('disabled' in request.resource.data);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['isPro', 'disabled', 'stripeAccountId']);
      allow delete: if isAdmin();
    }

    // ---------- identities ----------
    match /identities/{uid} {
      allow read: if true; // public profiles
      // Writes only via Cloud Functions (createIdentity / updateIdentity)
      allow write: if false;
    }

    // ---------- reputation ----------
    match /reputationScores/{uid} {
      allow read: if true;
      allow write: if false; // computed by Cloud Functions only
    }

    match /reputationLogs/{logId} {
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false; // written by Cloud Functions only
    }

    // ---------- marketplace ----------
    match /listings/{listingId} {
      allow read: if resource.data.status == 'active'
        || (isSignedIn() && resource.data.sellerId == request.auth.uid)
        || isModerator();
      // Creation and purchase go through Cloud Functions; sellers may edit
      // safe fields on their own listings.
      allow create: if false;
      allow update: if isSignedIn()
        && resource.data.sellerId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['sellerId', 'status', 'createdAt', 'purchaseCount']);
      allow delete: if isAdmin();
    }

    match /listingImages/{imageId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uploaderId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn()
        && (resource.data.uploaderId == request.auth.uid || isAdmin());
    }

    // ---------- transactions ----------
    match /transactions/{txId} {
      allow read: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid
            || isAdmin());
      allow write: if false; // Cloud Functions / Stripe webhook only
    }

    // ---------- disputes ----------
    match /disputes/{disputeId} {
      allow read: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid
            || isModerator());
      allow create: if false; // via createDispute function
      allow update: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['messages', 'updatedAt']);
      allow delete: if false;
    }

    // ---------- verification ----------
    match /verificationRequests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isModerator());
      allow create: if false; // via submitVerification function
      allow update: if false; // via approveVerification function
      allow delete: if false;
    }

    // ---------- stripe ----------
    match /stripeAccounts/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false; // Cloud Functions only
    }

    // ---------- ad packages ----------
    match /adPackages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- activity / fraud ----------
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
    }

    match /fraudSignals/{signalId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
    }

    // ---------- roles ----------
    match /roles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
