# Postgres (Vercel Postgres / Neon connection string)
DATABASE_URL=

# Auth.js (NextAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Optional Google OAuth provider (both values required to enable it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Blob (listing images + verification documents)
BLOB_READ_WRITE_TOKEN=

# Stripe Connect Standard
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
